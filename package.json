{
  "name": "core",
  "productName": "DECKS",
  "private": true,
  "version": "1.0.0",
  "description": "Offline pitch decks for designathons — by COЯE",
  "author": "COЯE Computer Club",
  "copyright": "Copyright © COЯE Computer Club",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5174\" \"wait-on http://127.0.0.1:5174 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron .\"",
    "build": "tsc --noEmit && vite build && vite build --config vite.present.config.ts",
    "build:present": "vite build --config vite.present.config.ts",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "npm run icons && npm run build && electron-builder --win",
    "dist:portable": "npm run icons && npm run build && electron-builder --win portable",
    "dist:nsis": "npm run icons && npm run build && electron-builder --win nsis",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "jszip": "^3.10.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "club.core.pitchdeck",
    "productName": "DECKS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-present/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon-light.png",
        "to": "icon-light.png"
      },
      {
        "from": "build/icon-dark.png",
        "to": "icon-dark.png"
      },
      {
        "from": "build/icon-light.ico",
        "to": "icon-light.ico"
      },
      {
        "from": "build/icon-dark.ico",
        "to": "icon-dark.ico"
      }
    ],
    "win": {
      "icon": "build/icon-dark.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": "core",
          "name": "Core Deck",
          "description": "Core pitch deck",
          "role": "Editor",
          "icon": "build/icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DECKS",
      "menuCategory": "COЯE",
      "uninstallDisplayName": "DECKS",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "license": "build/license.txt",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "DECKS-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DECKS-Portable-${version}.${ext}"
    }
  }
}
